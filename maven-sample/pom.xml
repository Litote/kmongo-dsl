<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven project using the KMongo DSL KAPT annotation processor (kmongo-dsl-annotation-processor).
  Checked by the CI: ./gradlew publishToMavenLocal && mvn -f maven-sample/pom.xml verify
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.litote.kmongo</groupId>
    <artifactId>kmongo-dsl-maven-sample</artifactId>
    <version>5.14.0-SNAPSHOT</version><!-- x-release-please-version -->

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <kotlin.version>2.4.21</kotlin.version>
        <kotlin.compiler.jvmTarget>17</kotlin.compiler.jvmTarget>
        <kmongo-dsl.version>5.14.0-SNAPSHOT</kmongo-dsl.version><!-- x-release-please-version -->
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.litote.kmongo</groupId>
                <artifactId>kmongo-dsl-bom</artifactId>
                <version>${kmongo-dsl.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.litote.kmongo</groupId>
            <artifactId>kmongo-dsl-sync</artifactId>
        </dependency>
        <dependency>
            <groupId>org.litote.kmongo</groupId>
            <artifactId>kmongo-dsl-jackson-mapping</artifactId>
        </dependency>
        <!-- @JacksonData + runtime of the serializers generated by kmongo-dsl-annotation-generator (versions from the BOM) -->
        <dependency>
            <groupId>org.litote.kmongo</groupId>
            <artifactId>kmongo-dsl-jackson-data</artifactId>
        </dependency>
        <dependency>
            <groupId>org.litote.kmongo</groupId>
            <artifactId>kmongo-dsl-jackson-module-loader</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
            <version>${kotlin.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-test-junit5</artifactId>
            <version>${kotlin.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>src/main/kotlin</sourceDirectory>
        <testSourceDirectory>src/test/kotlin</testSourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <version>${kotlin.version}</version>
                <executions>
                    <!-- generates the property paths (Friend_...) and the Jackson serializers (Friend_Serializer...)
                         before the compilation: the two processors share the KAPT classpath -->
                    <execution>
                        <id>kapt</id>
                        <goals>
                            <goal>kapt</goal>
                        </goals>
                        <configuration>
                            <sourceDirs>
                                <sourceDir>src/main/kotlin</sourceDir>
                            </sourceDirs>
                            <annotationProcessorPaths>
                                <annotationProcessorPath>
                                    <groupId>org.litote.kmongo</groupId>
                                    <artifactId>kmongo-dsl-annotation-processor</artifactId>
                                    <version>${kmongo-dsl.version}</version>
                                </annotationProcessorPath>
                                <annotationProcessorPath>
                                    <groupId>org.litote.kmongo</groupId>
                                    <artifactId>kmongo-dsl-annotation-generator</artifactId>
                                    <version>${kmongo-dsl.version}</version>
                                </annotationProcessorPath>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                    <execution>
                        <id>compile</id>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>test-compile</id>
                        <goals>
                            <goal>test-compile</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.1</version>
            </plugin>
        </plugins>
    </build>
</project>
